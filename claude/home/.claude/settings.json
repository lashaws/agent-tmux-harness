{
  "env": {
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(git branch -d *)",
      "Bash(git -C * branch -d *)",
      "Bash(git push origin --delete *)",
      "Bash(git -C * push origin --delete *)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "google-agents-cli-adk-code": "off",
    "google-agents-cli-deploy": "off",
    "google-agents-cli-eval": "off",
    "google-agents-cli-observability": "off",
    "google-agents-cli-publish": "off",
    "google-agents-cli-scaffold": "off",
    "google-agents-cli-workflow": "off",
    "grill-me": "on"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-input-needed.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/session-state stop",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-size-nudge.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-handback-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/your-turn prompt",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/session-state prompt",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/sleep-schedule-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "Explore|general-purpose|Plan|claude",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/subagent-report-cap.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/subagent-background-tasks.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/session-state threads",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/local-layer.sh session-start",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/agent-rules-sync",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/sleep-schedule-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-third-party.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/local-layer.sh pre-tool-use",
            "timeout": 5
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-instruction-size.py",
            "timeout": 5
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-personal.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": false,
    "postman@claude-plugins-official": false,
    "frontend-design@anthropic-plugin-directory": true,
    "cc-plugin-you-should-know@builtin": true,
    "caveman@anthropic-plugin-directory": true
  },
  "outputStyle": "Proactive",
  "sandbox": {
    "enabled": false
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "custom:lashaw",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1753967179724
  },
  "cleanupPeriodDays": 3650
}
