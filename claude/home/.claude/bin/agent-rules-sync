#!/bin/bash
# agent-rules-sync — write Codex's and Gemini's global instruction files from the one source
# Claude Code imports, so every agent on this Mac follows the same rules.
#   ~/.claude/agent-rules.md   shared rules (tracked in dotfiles)
#   ~/.claude/local/rules.md   this Mac only (never tracked)
# ->  ~/.codex/AGENTS.md and ~/.gemini/GEMINI.md (generated; edits there are overwritten)
# Runs from each Claude account's SessionStart hook and from the dotfiles harness install, so
# an edit to either source reaches Codex and Gemini without anyone running this by hand.
# Neither tool supports an @import that reaches outside its project, hence a generated copy.
set -u
SRC="$HOME/.claude/agent-rules.md"
LOCAL="$HOME/.claude/local/rules.md"
[ -f "$SRC" ] || exit 0

render() {
  printf '<!-- Generated by ~/.claude/bin/agent-rules-sync from ~/.claude/agent-rules.md and\n'
  printf '     ~/.claude/local/rules.md. Edit those; this file is overwritten. -->\n\n'
  cat "$SRC"
  if [ -f "$LOCAL" ]; then printf '\n'; cat "$LOCAL"; fi
}

for target in "$HOME/.codex/AGENTS.md" "$HOME/.gemini/GEMINI.md"; do
  dir=$(dirname "$target")
  [ -d "$dir" ] || continue                 # that agent isn't installed here
  if [ -s "$target" ] && ! grep -q 'Generated by ~/.claude/bin/agent-rules-sync' "$target"; then
    cp -p "$target" "$target.bak-$(date +%Y%m%d%H%M%S)"   # hand-written file: keep a copy once
  fi
  tmp=$(mktemp "$dir/.agent-rules.XXXXXX")
  render > "$tmp"
  if cmp -s "$tmp" "$target" 2>/dev/null; then rm -f "$tmp"; else mv "$tmp" "$target"; chmod 644 "$target"; fi
done
exit 0
