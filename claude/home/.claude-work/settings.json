{
  "cleanupPeriodDays": 3650,
  "env": {
    "CPP_GATE": "off",
    "DELEGATED_FLOW": "on",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue create *)",
      "Bash(gh issue reopen *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-input-needed.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-work/hooks/trueage-auto-tidy.sh",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/local-layer.sh session-start",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/session-state threads",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/agent-rules-sync",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/session-state stop",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-handback-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-work/bin/your-turn prompt",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/bin/session-state prompt",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/sleep-schedule-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/sleep-schedule-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-third-party.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/local-layer.sh pre-tool-use",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-instruction-size.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude-work/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "frontend-design@anthropic-plugin-directory": true
  },
  "outputStyle": "Proactive",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "custom:lashaw",
  "skipAutoPermissionPrompt": true
}
